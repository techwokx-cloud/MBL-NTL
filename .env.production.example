# MBL–NTL SulNOxEco Ghana — Production Environment Variables
# Copy this file to .env.production and fill in actual values
# NEVER commit .env.production to Git

# ============================================================================
# SITE CONFIGURATION
# ============================================================================
NEXT_PUBLIC_SITE_URL=https://www.mbl-ntlsulnox.com
NEXT_PUBLIC_SITE_NAME=MBL-NTL SulNOxEco Ghana
NODE_ENV=production

# ============================================================================
# WHATSAPP INTEGRATION
# ============================================================================
# Get these from WhatsApp Business Account
NEXT_PUBLIC_WHATSAPP_NUMBER=+233XXXXXXXXX
NEXT_PUBLIC_WHATSAPP_BUSINESS_PHONE_ID=your_phone_id_from_whatsapp
WHATSAPP_API_TOKEN=your_bearer_token_from_whatsapp
# Optional: Webhook secret for WhatsApp message verification
WHATSAPP_WEBHOOK_SECRET=your_webhook_secret

# ============================================================================
# AI SALES AGENT
# ============================================================================
# Options: anthropic | openai | local
NEXT_PUBLIC_AI_PROVIDER=anthropic

# Anthropic Claude API
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# OpenAI API (if using OpenAI instead)
# OPENAI_API_KEY=sk-your-openai-key-here

# ============================================================================
# ANALYTICS & MONITORING
# ============================================================================
# Google Analytics 4
# Get ID from Google Analytics console
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console Verification Token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_token

# Sentry Error Tracking (optional)
# SENTRY_DSN=https://key@sentry.io/project-id

# ============================================================================
# EMAIL SERVICE (Optional)
# ============================================================================
EMAIL_SERVICE_ENABLED=false

# SendGrid Email Service
SENDGRID_API_KEY=SG.your-sendgrid-key-here
SENDGRID_FROM_EMAIL=noreply@mbl-ntlsulnox.com

# Gmail SMTP (if using Gmail)
# GMAIL_USER=your-email@gmail.com
# GMAIL_PASS=your-app-specific-password

# ============================================================================
# PAYMENT GATEWAY (e-commerce)
# ============================================================================
# Stripe Payment Processing
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-public-key
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# MTN Mobile Money (if integrating)
# MTN_API_KEY=your-mtn-api-key
# MTN_MERCHANT_ID=your-merchant-id

# Paypal (if integrating)
# PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_CLIENT_SECRET=your-paypal-secret

# ============================================================================
# DATABASE (Future phases)
# ============================================================================
# PostgreSQL
# DATABASE_URL=postgresql://user:password@host:5432/sulnoxeco

# MongoDB
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/sulnoxeco

# ============================================================================
# STORAGE & CDN
# ============================================================================
# AWS S3 (for file uploads)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_S3_BUCKET=sulnoxeco-bucket
# AWS_REGION=us-east-1

# Cloudflare CDN
# CLOUDFLARE_API_TOKEN=your-cloudflare-token
# CLOUDFLARE_ZONE_ID=your-zone-id

# ============================================================================
# SECURITY & SECRETS
# ============================================================================
# JWT Secret for authentication (if needed)
JWT_SECRET=your-very-long-random-secret-key-here-min-32-chars

# CORS Configuration
CORS_ORIGIN=https://www.mbl-ntlsulnox.com

# ============================================================================
# LOGGING & DEBUGGING
# ============================================================================
# Log level: error | warn | info | debug
LOG_LEVEL=info

# Enable detailed logging
DEBUG=false

# ============================================================================
# THIRD-PARTY INTEGRATIONS
# ============================================================================
# Slack Notifications (for errors)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Mailchimp Newsletter
# MAILCHIMP_API_KEY=your-mailchimp-api-key
# MAILCHIMP_LIST_ID=your-list-id

# Calendly (if using for consultations)
# CALENDLY_API_TOKEN=your-calendly-token

# ============================================================================
# DEPLOYMENT & INFRASTRUCTURE
# ============================================================================
# VPS Hostname (for monitoring)
VPS_HOSTNAME=your-vps-ip-or-domain

# Redis (for caching, optional)
# REDIS_URL=redis://user:password@host:6379

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable/disable features in production
FEATURE_SHOP_ENABLED=false
FEATURE_AI_CHAT_ENABLED=true
FEATURE_EMAIL_NOTIFICATIONS=false
FEATURE_ANALYTICS_ENABLED=true

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================
CACHE_TTL_SHORT=300  # 5 minutes
CACHE_TTL_MEDIUM=3600  # 1 hour
CACHE_TTL_LONG=86400  # 24 hours

# ============================================================================
# NOTES FOR DEPLOYMENT
# ============================================================================
# 1. NEVER commit this file to Git (it's in .gitignore)
# 2. Use a secure method to pass variables to production
#    - Docker: Use environment variables or secrets file
#    - VPS: Copy to .env.production and restrict permissions (chmod 600)
#    - Vercel: Use dashboard to set environment variables
# 3. Rotate secrets regularly (API keys, passwords)
# 4. Use different keys for staging vs production
# 5. Monitor for unauthorized access to secrets
# 6. Backup secrets securely (encrypted password manager)
# 7. Alert team if a secret is compromised
